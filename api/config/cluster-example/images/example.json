{
  "alias": "example-alias",
  "image_name": "tensorflow/tensorflow:latest-gpu",
  "volumes": [
    {
      "source": "/mnt/host_data/models",
      "target": "/app/models",
      "type": "bind"
    }
  ],
  "args": [
    "python3",
    "/app/models/train.py"
  ],
  "nanoCPULimit": 2000000000,
  "memoryBytesLimit": 4294967296,
  "persistent": false,
  "max_jobs": 100,
  "timeout": 3600
}